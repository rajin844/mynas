class PoolsPage extends StatefulWidget {
  const PoolsPage({super.key});

  @override
  State<PoolsPage> createState() => _PoolsPageState();
}

class _PoolsPageState extends State<PoolsPage> {
  bool _creating = false;

  @override
  void initState() {
    super.initState();
    Future.microtask(() {
      context.read<ZfsProvider>().loadPools();
      context.read<StorageProvider>().loadSummary();
    });
  }

  Future<void> _refresh() async {
    await Future.wait([
      context.read<ZfsProvider>().loadPools(),
      context.read<StorageProvider>().loadSummary(),
    ]);
  }

  @override
  Widget build(BuildContext context) {
    final zfs = context.watch<ZfsProvider>();
    final storage = context.watch<StorageProvider>();
    final pools = zfs.pools;
    final mq = MediaQuery.of(context);

    final crossAxisCount = _calcCols(mq.size.width);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Pools'),
        actions: [
          IconButton(
              tooltip: 'Refresh',
              icon: const Icon(Icons.refresh),
              onPressed: () => _refresh()),
        ],
      ),
      body: RefreshIndicator(
        onRefresh: _refresh,
        child: Padding(
          padding: const EdgeInsets.all(12),
          child: Column(children: [
            _StorageSummary(storage),
            const SizedBox(height: 12),
            Expanded(
              child: pools.isEmpty
                  ? _EmptyPools(onCreate: _onCreatePool)
                  : GridView.builder(
                      gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                        crossAxisCount: crossAxisCount,
                        crossAxisSpacing: 12,
                        mainAxisSpacing: 12,
                        childAspectRatio: 1.05,
                      ),
                      itemCount: pools.length,
                      itemBuilder: (context, idx) {
                        final p = pools[idx];
                        return PoolCard(
                          pool: p,
                          onRefresh: () =>
                              context.read<ZfsProvider>().loadPools(),
                          onDestroy: (name) => _confirmDestroy(context, name),
                          onOpen: (name) => Navigator.pushNamed(
                              context, '/pool',
                              arguments: {'name': name}),
                        );
                      },
                    ),
            ),
          ]),
        ),
      ),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: _onCreatePool,
        icon: const Icon(Icons.add),
        label: const Text('Create Pool'),
      ),
      drawer: Drawer(
        child: ListView(
          children: [
            const DrawerHeader(child: Text('MyNAS')),
            ListTile(
              leading: const Icon(Icons.dashboard),
              title: const Text('Dashboard'),
              onTap: () => Navigator.pushNamed(context, '/'),
            ),
            ListTile(
                leading: const Icon(Icons.storage_rounded),
                title: const Text('Storage'),
                onTap: () => Navigator.pushNamed(context, '/storage')),
            ListTile(
                leading: const Icon(Icons.lock),
                title: const Text('ACL'),
                onTap: () => Navigator.pushNamed(context, '/acl')),
          ],
        ),
      ),
    );
  }

  int _calcCols(double width) {
    if (width >= 1400) return 4;
    if (width >= 1100) return 3;
    if (width >= 700) return 2;
    return 1;
  }

  Future<void> _onCreatePool() async {
    // Keep this small — call your existing create pool flow / dialog
    final res = await showDialog<Map<String, dynamic>>(
        context: context, builder: (_) => const _CreatePoolDialog());
    if (res == null) return;
    final name = res['name'] as String;
    final devices = List<String>.from(res['devices'] as List);
    final raidz = res['raidz'] as String?;
    final dryRun = res['dryRun'] as bool? ?? true;

    try {
      setState(() => _creating = true);
      final preview = await context
          .read<StorageProvider>()
          .createPool(name, devices, raidz: raidz, dryRun: dryRun);
      if (dryRun) {
        final confirmed = await showDialog<bool>(
            context: context,
            builder: (_) => AlertDialog(
                  title: const Text('Dry-run preview'),
                  content:
                      SingleChildScrollView(child: Text(preview.toString())),
                  actions: [
                    TextButton(
                        onPressed: () => Navigator.pop(context, false),
                        child: const Text('Cancel')),
                    ElevatedButton(
                        onPressed: () => Navigator.pop(context, true),
                        child: const Text('Create')),
                  ],
                ));
        if (confirmed == true) {
          await context
              .read<StorageProvider>()
              .createPool(name, devices, raidz: raidz, dryRun: false);
          await context.read<ZfsProvider>().loadPools();
        }
      } else {
        await context.read<ZfsProvider>().loadPools();
      }
    } catch (e) {
      ScaffoldMessenger.of(context)
          .showSnackBar(SnackBar(content: Text('Create pool failed: $e')));
    } finally {
      setState(() => _creating = false);
    }
  }

  Future<void> _confirmDestroy(BuildContext ctx, String poolName) async {
    final ok = await showDialog<bool>(
        context: ctx,
        builder: (_) => AlertDialog(
              title: const Text('Destroy pool'),
              content: Text('Destroy pool "$poolName"? This will remove data.'),
              actions: [
                TextButton(
                    onPressed: () => Navigator.pop(ctx, false),
                    child: const Text('Cancel')),
                ElevatedButton(
                    onPressed: () => Navigator.pop(ctx, true),
                    child: const Text('Destroy')),
              ],
            ));
    if (ok != true) return;
    try {
      await context.read<ZfsProvider>().destroyPool(poolName);
      await context.read<ZfsProvider>().loadPools();
    } catch (e) {
      ScaffoldMessenger.of(context)
          .showSnackBar(SnackBar(content: Text('Destroy failed: $e')));
    }
  }
}

/// Summary row above the grid
class _StorageSummary extends StatelessWidget {
  final StorageProvider storage;
  const _StorageSummary(this.storage, {super.key});
  @override
  Widget build(BuildContext context) {
    final summary = storage.summary ?? {};
    final totalPools = (summary['pools'] as List?)?.length ?? 0;
    final totalDisks = (summary['disks'] as List?)?.length ?? 0;
    final totalDatasets = (summary['datasets'] as List?)?.length ?? 0;
    return Row(children: [
      _summaryChip('Pools', totalPools.toString(), icon: Icons.storage),
      const SizedBox(width: 8),
      _summaryChip('Disks', totalDisks.toString(), icon: Icons.dns),
      const SizedBox(width: 8),
      _summaryChip('Datasets', totalDatasets.toString(), icon: Icons.folder),
      const Spacer(),
      ElevatedButton.icon(
          onPressed: () => storage.loadSummary(),
          icon: const Icon(Icons.sync),
          label: const Text('Refresh Storage'))
    ]);
  }

  Widget _summaryChip(String label, String value, {required IconData icon}) {
    return Chip(
      avatar: CircleAvatar(child: Icon(icon, size: 18)),
      label: Column(mainAxisSize: MainAxisSize.min, children: [
        Text(label, style: const TextStyle(fontSize: 12)),
        Text(value, style: const TextStyle(fontWeight: FontWeight.bold))
      ]),
    );
  }
}

