/// Create Pool dialog — small pickers (uses StorageProvider.loadDisks)
class _CreatePoolDialog extends StatefulWidget {
  const _CreatePoolDialog({super.key});
  @override
  State<_CreatePoolDialog> createState() => _CreatePoolDialogState();
}

class _CreatePoolDialogState extends State<_CreatePoolDialog> {
  final nameCtrl = TextEditingController();
  String raidz = 'raidz1';
  bool dryRun = true;
  final List<String> selected = [];

  @override
  void initState() {
    super.initState();
    Future.microtask(() => context.read<StorageProvider>().loadDisks());
  }

  @override
  Widget build(BuildContext context) {
    final store = context.watch<StorageProvider>();
    final disks = store.disks ?? [];
    return AlertDialog(
      title: const Text('Create Pool'),
      content: SingleChildScrollView(
        child: Column(mainAxisSize: MainAxisSize.min, children: [
          TextField(
              controller: nameCtrl,
              decoration: const InputDecoration(labelText: 'Pool Name')),
          const SizedBox(height: 10),
          Align(
              alignment: Alignment.centerLeft,
              child: const Text('Select disks',
                  style: TextStyle(fontWeight: FontWeight.w600))),
          const SizedBox(height: 8),
          SizedBox(
            height: 160,
            child: disks.isEmpty
                ? const Center(child: Text('No disks available'))
                : ListView.builder(
                    itemCount: disks.length,
                    itemBuilder: (ctx, i) {
                      final d = disks[i];
                      final id = d['devpath'] ?? d['name'] ?? d.toString();
                      final selectedFlag = selected.contains(id);
                      return CheckboxListTile(
                        value: selectedFlag,
                        title: Text(d['name'] ?? id),
                        subtitle:
                            Text('${d['model'] ?? ''} • ${d['size'] ?? ''}'),
                        onChanged: (v) {
                          setState(() {
                            if (v == true) {
                              selected.add(id);
                            } else {
                              selected.remove(id);
                            }
                          });
                        },
                      );
                    },
                  ),
          ),
          const SizedBox(height: 10),
          Row(children: [
            const Text('RAIDZ level:'),
            const SizedBox(width: 8),
            DropdownButton<String>(
                value: raidz,
                items: const [
                  DropdownMenuItem(value: 'single', child: Text('Single')),
                  DropdownMenuItem(value: 'mirror', child: Text('Mirror')),
                  DropdownMenuItem(value: 'raidz1', child: Text('RAIDZ1')),
                  DropdownMenuItem(value: 'raidz2', child: Text('RAIDZ2')),
                ],
                onChanged: (v) => setState(() => raidz = v ?? 'raidz1'))
          ]),
          const SizedBox(height: 8),
          Row(children: [
            Checkbox(
                value: dryRun,
                onChanged: (v) => setState(() => dryRun = v ?? true)),
            const SizedBox(width: 6),
            const Flexible(
                child: Text('Dry-run (preview layout before creating)')),
          ]),
        ]),
      ),
      actions: [
        TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancel')),
        ElevatedButton(
            onPressed: selected.isEmpty || nameCtrl.text.trim().isEmpty
                ? null
                : () {
                    Navigator.pop(context, {
                      "name": nameCtrl.text.trim(),
                      "devices": selected,
                      "raidz": raidz,
                      "dryRun": dryRun
                    });
                  },
            child: const Text('Preview')),
      ],
    );
  }
}
