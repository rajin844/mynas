/// Pool card widget
class PoolCard extends StatelessWidget {
  final Map pool;
  final Future<void> Function() onRefresh;
  final void Function(String poolName) onDestroy;
  final void Function(String poolName) onOpen;

  const PoolCard(
      {super.key,
      required this.pool,
      required this.onRefresh,
      required this.onDestroy,
      required this.onOpen});

  String get name => pool['name'] ?? pool['pool_name'] ?? 'unknown';
  String get health =>
      (pool['health'] ?? pool['status'] ?? 'UNKNOWN').toString();
  double usagePercent() {
    try {
      final cap =
          _toDouble(pool['size'] ?? pool['capacity'] ?? pool['total'] ?? 0);
      final used =
          _toDouble(pool['alloc'] ?? pool['allocated'] ?? pool['used'] ?? 0);
      if (cap <= 0) return 0.0;
      return (used / cap) * 100.0;
    } catch (e) {
      return 0.0;
    }
  }

  double _toDouble(dynamic v) {
    if (v == null) return 0.0;
    if (v is num) return v.toDouble();
    final s = v.toString().replaceAll(RegExp(r'[^0-9.]'), '');
    return double.tryParse(s) ?? 0.0;
  }

  Color _healthColor(BuildContext context) {
    final h = health.toUpperCase();
    if (h.contains('ONLINE') || h.contains('HEALTHY') || h.contains('OK'))
      return Colors.green;
    if (h.contains('DEGRADED') || h.contains('WARN')) return Colors.orange;
    return Theme.of(context).colorScheme.error;
  }

  List<Map<String, dynamic>> _vdevs() {
    final raw = pool['vdevs'] ??
        pool['vdev_list'] ??
        pool['devices'] ??
        pool['devices_json'];
    if (raw is List)
      return List<Map<String, dynamic>>.from(
          raw.map((e) => e is Map ? e : {'name': e}));
    if (raw is String) {
      try {
        // fallback: comma separated
        return raw.split(',').map((s) => {'name': s.trim()}).toList();
      } catch (e) {
        return [];
      }
    }
    return [];
  }

  // Attempt to get scrub progress (may be provided by pool object)
  double scrubProgress() {
    final p = pool['scrub_progress'] ?? pool['scrub_pct'] ?? pool['scrub'] ?? 0;
    if (p is num) return (p.toDouble() / 100.0).clamp(0.0, 1.0);
    if (p is String) {
      final val = double.tryParse(p.replaceAll('%', '')) ?? 0.0;
      return (val / 100.0).clamp(0.0, 1.0);
    }
    return 0.0;
  }

  @override
  Widget build(BuildContext context) {
    final usage = usagePercent();
    final vdevs = _vdevs();

    return Card(
      elevation: 3,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: InkWell(
        onTap: () => onOpen(name),
        borderRadius: BorderRadius.circular(12),
        child: Padding(
          padding: const EdgeInsets.all(12),
          child:
              Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Row(children: [
              Expanded(
                  child: Text(name,
                      style: const TextStyle(
                          fontSize: 18, fontWeight: FontWeight.w600))),
              HealthBadge(text: health, color: _healthColor(context)),
              const SizedBox(width: 6),
              PopupMenuButton<String>(
                onSelected: (v) async {
                  if (v == 'destroy') onDestroy(name);
                  if (v == 'properties') onOpen(name);
                  if (v == 'refresh') await onRefresh();
                  if (v == 'scrub_start')
                    context.read<ZfsProvider>().startScrub(name);
                  if (v == 'scrub_stop')
                    context.read<ZfsProvider>().stopScrub(name);
                },
                itemBuilder: (_) => [
                  const PopupMenuItem(
                      value: 'properties', child: Text('Properties')),
                  const PopupMenuItem(value: 'refresh', child: Text('Refresh')),
                  const PopupMenuDivider(),
                  const PopupMenuItem(
                      value: 'scrub_start', child: Text('Start Scrub')),
                  const PopupMenuItem(
                      value: 'scrub_stop', child: Text('Stop Scrub')),
                  const PopupMenuDivider(),
                  const PopupMenuItem(
                      value: 'destroy',
                      child:
                          Text('Destroy', style: TextStyle(color: Colors.red))),
                ],
              )
            ]),
            const SizedBox(height: 10),
            Row(children: [
              Expanded(
                child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text('${usage.toStringAsFixed(1)}% used',
                          style: const TextStyle(fontSize: 12)),
                      const SizedBox(height: 6),
                      LinearProgressIndicator(
                          value: (usage.clamp(0, 100) / 100.0), minHeight: 8),
                    ]),
              ),
              const SizedBox(width: 12),
              SizedBox(
                width: 88,
                child: Column(children: [
                  Icon(Icons.storage, size: 28, color: _healthColor(context)),
                  const SizedBox(height: 6),
                  Text(pool['type']?.toString() ?? 'zfs',
                      style: const TextStyle(fontSize: 12)),
                ]),
              )
            ]),
            const SizedBox(height: 10),
            // VDEV summary row
            Wrap(
                spacing: 6,
                runSpacing: 6,
                children: vdevs.take(6).map((v) {
                  final t = (v['type'] ?? v['name'] ?? 'vdev').toString();
                  final disks =
                      (v['disks'] ?? v['devices'] ?? v['members']) as dynamic;
                  final count = (disks is List)
                      ? disks.length
                      : (disks is String ? disks.split(',').length : 1);
                  return VdevChip(type: t, count: count);
                }).toList()),
            const SizedBox(height: 10),
            // scrub progress inline
            if (scrubProgress() > 0)
              Column(children: [
                Row(children: [
                  const Text('Scrub progress', style: TextStyle(fontSize: 12)),
                  const Spacer(),
                  Text('${(scrubProgress() * 100).toStringAsFixed(1)}%')
                ]),
                const SizedBox(height: 6),
                LinearProgressIndicator(value: scrubProgress(), minHeight: 8),
              ]),
            const Spacer(),
            Row(children: [
              Text(pool['created_at']?.toString() ?? '',
                  style: const TextStyle(fontSize: 11, color: Colors.grey)),
              const Spacer(),
              IconButton(
                tooltip: 'Quick scrub',
                onPressed: () => context.read<ZfsProvider>().startScrub(name),
                icon: const Icon(Icons.play_arrow),
              ),
              IconButton(
                tooltip: 'Stop scrub',
                onPressed: () => context.read<ZfsProvider>().stopScrub(name),
                icon: const Icon(Icons.stop),
              ),
            ])
          ]),
        ),
      ),
    );
  }
}

